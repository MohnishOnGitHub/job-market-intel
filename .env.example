# Copy this file to .env and replace the placeholder values.
# Never commit a real .env file.

# Required to load jobs for matching.
# Example: postgresql://USER:PASSWORD@localhost:5432/job_market
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/job_market

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Résumé upload limit
MAX_UPLOAD_MB=5

# Optional. Only needed for Adzuna ingestion:
# python scripts/ingest_adzuna.py --query "python developer" --pages 1
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Embeddings / hybrid ranking (Phase 4)
# hashing = deterministic local baseline (default, no model download)
# sentence-transformers = real semantic embeddings (optional extra package)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=256
CANDIDATE_COUNT=100
RECENCY_TAU_DAYS=30

# Example weights from DESIGN.md. Not empirically optimal until Phase 5.
RANK_WEIGHT_SEMANTIC=0.50
RANK_WEIGHT_SKILL=0.25
RANK_WEIGHT_EXPERIENCE=0.10
RANK_WEIGHT_RECENCY=0.10
RANK_WEIGHT_LOCATION=0.05
